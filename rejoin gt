--[[ ============================================================
     AUTO JOIN  v1.0  --  one-button auto re-enter current world
     Game: Ugc (112863874972771)   place version: v1200
     Executor: Madium / Real.
     No RightCtrl, no loadstring, no HttpGet, no Rayfield.

     WHAT IT DOES
       The game sometimes drops you back to the world-discovery
       menu (same server, you are not disconnected). This script
       watches that menu and, while it is open, presses the same
       "Enter World" action once every 10 seconds.

       It uses the game's OWN UI function, not a hand-made remote:

         menu.enter("WORLDNAME")

       That is the exact wrapper the "Enter World" button calls
       (v1200 Game module L4511 `enter`, exported on the menu
       table and also passed to the picker as `enter`). It hides
       the picker, restores the HUD and updates the status text
       exactly like a human click. No new remotes are fired and
       no packets are crafted by hand.

     HOW IT FINDS THINGS (v1200 hides its scripts)
       The menu module (E9zevLEKGwgD) mounts a ScreenGui named
       "MenuGui" into PlayerGui and creates one Frame per layer:

           PlayerGui.MenuGui.WorldPicker.Visible == true
             -> you are sitting in the discovery menu

       The menu table itself (the mount() return value) is found
       in the garbage collector by IDENTITY, not by name:

           rawget(candidate, "screen") == PlayerGui.MenuGui
           and candidate has enter() / openPicker()

       Its `enter` closure keeps the game's argument table as an
       upvalue; that table has currentWorld() (returns the world
       name) and enter() (the raw join). So we read the name and
       call the UI wrapper. Nothing is guessed.

       Fallback if the UI table cannot be found: scan for the
       world table by shape (goTo + w + h + name + enter) and
       call world.enter(name) directly, then hide the picker.

     SHAPE, NOT NAME
       v1200 unparents and renames its modules every server.
       Shapes ("has these functions") are stable, names are not.

     USE
       Run once. One button toggles it.
         OFF -> do nothing (browse worlds normally)
         ON  -> while the picker is open, rejoin the current
                world every 10 seconds until it succeeds.
                After 6 failures in a row it slows to 30 s
                (a world that no longer exists should not be
                hammered); any success resets the timer.
       Re-running the script destroys the old panel and stops
       the old loop; it does not stack.
   ============================================================ ]]

local TAG = "[AJ]"

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TeleportService")
local LP = Players.LocalPlayer

local function say(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[#parts + 1] = tostring(select(i, ...))
    end
    print(TAG, table.concat(parts, " "))
end

-- ------------------------------------------------------------ executor API
-- IMPORTANT: Real hands the script an EMPTY _G. Executor functions are only
-- reachable as direct globals, so never do _G["getgc"] etc.
local API = {
    getgc          = type(getgc) == "function" and getgc or nil,
    getupvalues    = type(getupvalues) == "function" and getupvalues or nil,
    getconnections = type(getconnections) == "function" and getconnections or nil,
}

-- optional shared env (cache + last world name)
local genv = nil
if type(getgenv) == "function" then
    local ok, g = pcall(getgenv)
    if ok and type(g) == "table" then genv = g end
end

-- ------------------------------------------------------------ helpers
-- rawget never runs __index, so a table with a hostile metatable cannot
-- abort the scan (this used to crash an older build).
local function rawField(t, k)
    if type(t) ~= "table" then return nil end
    return rawget(t, k)
end

-- getupvalues with debug fallback; returns a plain array
local function upsOf(fn)
    local out = {}
    if type(fn) ~= "function" then return out end
    if API.getupvalues then
        local ok, u = pcall(API.getupvalues, fn)
        if ok and type(u) == "table" then
            for k, v in pairs(u) do
                if type(k) == "number" then out[#out + 1] = v end
            end
            if #out > 0 then return out end
            out = {}
        end
    end
    if type(debug) == "table" and type(debug.getupvalue) == "function" then
        for i = 1, 200 do
            local ok, name, val = pcall(debug.getupvalue, fn, i)
            if not ok or name == nil then break end
            out[i] = val
        end
    end
    return out
end

-- world table shape (same test modmove uses)
local function isWorld(t)
    if type(t) ~= "table" then return false end
    return type(rawget(t, "goTo")) == "function"
        and type(rawget(t, "w")) == "number"
        and type(rawget(t, "h")) == "number"
end

-- menu mount() return value: the ScreenGui it created is a raw field
local function isMenuTable(t, mgui)
    if type(t) ~= "table" then return false end
    if rawget(t, "screen") ~= mgui then return false end
    return type(rawget(t, "enter")) == "function"
        and type(rawget(t, "openPicker")) == "function"
        and type(rawget(t, "layers")) == "table"
end

-- the game's argument table, reachable through the menu closures
local function isMenuArgs(t)
    if type(t) ~= "table" then return false end
    return type(rawget(t, "currentWorld")) == "function"
        and type(rawget(t, "enter")) == "function"
end

-- ------------------------------------------------------------ discovery
local function eachGcTable(fn)
    if not API.getgc then return 0 end
    local ok, gc = pcall(API.getgc, true)
    if not ok or type(gc) ~= "table" then ok, gc = pcall(API.getgc) end
    if not ok or type(gc) ~= "table" then return 0 end
    local n = 0
    for _, v in ipairs(gc) do
        if type(v) == "table" then
            n = n + 1
            if fn(v) then return n end
        end
    end
    return n
end

local function findMenu(mgui)
    local hit = nil
    eachGcTable(function(v)
        if isMenuTable(v, mgui) then
            hit = v
            return true
        end
        return false
    end)
    return hit
end

local function findArgs(menu)
    for _, field in ipairs({ "enter", "openPicker", "blocking", "closeDialogs" }) do
        local fn = rawField(menu, field)
        if type(fn) == "function" then
            for _, u in ipairs(upsOf(fn)) do
                if isMenuArgs(u) then return u end
            end
        end
    end
    return nil
end

local function findWorld()
    local strict, loose = nil, nil
    eachGcTable(function(v)
        if not loose and isWorld(v) then loose = v end
        if isWorld(v) and type(rawget(v, "enter")) == "function"
            and type(rawget(v, "name")) == "string" then
            strict = v
            return true
        end
        return false
    end)
    return strict or loose
end

-- ------------------------------------------------------------ no-getgc route
-- On an executor without getgc we can still reach the menu's own enter
-- wrapper through the buttons' Activated connections:
--
--   button.Activated  ->  callback (upvalue: enter wrapper)
--   enter wrapper     ->  upvalue: the game's argument table (a2)
--
-- a2 has currentWorld() (name) and enter() (raw join).  The wrapper itself
-- is the UI function, so calling it is exactly a human click.
local function connFunction(c)
    local ok, f = pcall(function() return c.Function end)
    if ok and type(f) == "function" then return f end
    ok, f = pcall(function() return c.func end)
    if ok and type(f) == "function" then return f end
    return nil
end

-- Connection chain the game builds for every menu button:
--
--   Activated -> cb (upvalues: sound module, a7)
--   a7        -> function() enter(i9) end
--   a7 upvals -> enter wrapper + i9
--   wrapper   -> upvalues: a2 (args), the WorldPicker frame, hud, ...
--
-- So walk two hops and require the found function to close over BOTH the
-- args table and the picker frame. That rejects any other menu function
-- that also happens to close over a2 (hud does).
local function wrapperFromCallback(cb, picker)
    for _, a7 in ipairs(upsOf(cb)) do
        if type(a7) == "function" then
            local bestW, bestA = nil, nil
            for _, w in ipairs(upsOf(a7)) do
                if type(w) == "function" then
                    local a, hasPicker = nil, false
                    for _, u in ipairs(upsOf(w)) do
                        if isMenuArgs(u) then a = u end
                        if u == picker then hasPicker = true end
                    end
                    if a then
                        if hasPicker then return w, a end
                        if not bestW then bestW, bestA = w, a end
                    end
                end
            end
            if bestW then return bestW, bestA end
        end
    end
    return nil, nil
end

local function findEnterViaGui(mgui)
    if not API.getconnections then return nil, nil end
    local picker = mgui:FindFirstChild("WorldPicker")
    if not picker then return nil, nil end
    local okDesc, descendants = pcall(function() return picker:GetDescendants() end)
    if not okDesc or type(descendants) ~= "table" then return nil, nil end

    for _, d in ipairs(descendants) do
        local okCls, cls = pcall(function() return d.ClassName end)
        if okCls and (cls == "TextButton" or cls == "ImageButton") then
            local okSig, sig = pcall(function() return d.Activated end)
            if okSig and sig then
                local okC, conns = pcall(API.getconnections, sig)
                if okC and type(conns) == "table" then
                    for _, c in ipairs(conns) do
                        local fn = connFunction(c)
                        if fn then
                            local wrapper, a = wrapperFromCallback(fn, picker)
                            if wrapper then return wrapper, a end
                        end
                    end
                end
            end
        end
    end
    return nil, nil
end

-- ------------------------------------------------------------ live state
local function playerGui()
    local ok, pg = pcall(function() return LP:FindFirstChild("PlayerGui") end)
    if ok and pg then return pg end
    return nil
end

-- The ScreenGui is called "MenuGui" in v1200, but find it by its
-- "WorldPicker" layer instead of trusting the name.  A rename then
-- cannot blind us.
local function findMenuGui(pg)
    if not pg then return nil end
    local direct = pg:FindFirstChild("MenuGui")
    if direct and direct:FindFirstChild("WorldPicker") then return direct end
    for _, c in ipairs(pg:GetChildren()) do
        local okCls, cls = pcall(function() return c.ClassName end)
        if okCls and cls == "ScreenGui" then
            local okW, w = pcall(function() return c:FindFirstChild("WorldPicker") end)
            if okW and w then return c end
        end
    end
    return nil
end

local function pickerParts()
    local pg = playerGui()
    if not pg then return nil, nil end
    local mgui = findMenuGui(pg)
    if not mgui then return nil, nil end
    local picker = mgui:FindFirstChild("WorldPicker")
    return mgui, picker
end

local function pickerVisible()
    local _, picker = pickerParts()
    if not picker then return false end
    local ok, vis = pcall(function() return picker.Visible end)
    return ok and vis == true
end

local function hidePicker()
    local _, picker = pickerParts()
    if picker then
        pcall(function() picker.Visible = false end)
    end
end

