-- ------------------------------------------------------------ dragging
local dragging = false
local dragStart = nil
local startPos = nil

title.InputBegan:Connect(function(input)
    if not gui.Parent then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = panel.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if not gui.Parent or not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    local delta = input.Position - dragStart
    panel.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end)

-- ------------------------------------------------------------ controls
local on = false
local JOIN_EVERY = 10.0      -- seconds between join attempts
local SLOW_EVERY = 30.0      -- back off after repeated failures
local busy = false
local lastTry = 0
local joined = 0
local fails = 0

-- If the world is gone, hammering the same join RPC every 10 s forever is
-- pointless.  After 6 failures in a row, slow down; any success resets it.
local function interval()
    if fails >= 6 then return SLOW_EVERY end
    return JOIN_EVERY
end

local function setStatus(text)
    pcall(function() status.Text = tostring(text) end)
end

local function setOn(v, quiet)
    on = v and true or false
    if on then
        toggle.Text = "AUTO JOIN: ON"
        toggle.BackgroundColor3 = Color3.fromRGB(30, 140, 82)
    else
        toggle.Text = "AUTO JOIN: OFF"
        toggle.BackgroundColor3 = Color3.fromRGB(58, 58, 72)
    end
    if not quiet then
        say(on and "auto join ON" or "auto join OFF")
    end
end

toggle.Activated:Connect(function()
    setOn(not on)
    if on then
        say("will re-enter the current world every " .. JOIN_EVERY .. "s while the picker is open")
    end
end)

setOn(false, true)

-- ------------------------------------------------------------ resolve loop
local menu, args, world, enterFn = nil, nil, nil, nil
local lastResolve = 0
local RESOLVE_EVERY = 10.0    -- GC scans are heavy; retry every 10 s only

local function ensureResolved(force)
    local now = os.clock()
    if not force and (now - lastResolve) < RESOLVE_EVERY then return end
    lastResolve = now

    local mgui = pickerParts()

    -- invalidate cache only when we actually have a screen to compare to
    if menu and mgui and rawField(menu, "screen") ~= mgui then
        menu, args, enterFn = nil, nil, nil
    end

    if not menu and mgui then
        menu = findMenu(mgui)
        if menu then say("menu UI found") end
    end
    if menu and not args then
        args = findArgs(menu)
        if args then say("world name source: menu args") end
    end

    -- no getgc (or menu table not found): use the buttons' connections
    if not args and mgui then
        local fn, a = findEnterViaGui(mgui)
        if fn then
            enterFn, args = fn, a
            say("enter wrapper found via GUI connections")
        end
    end

    -- if the menu's argument table could not be read, we still need the
    -- world table for the name, even though the menu can join on its own
    if not args and not world then
        world = findWorld()
        if world then say("world table found (fallback)") end
    end
end

local function currentName()
    if args then
        local ok, n = pcall(args.currentWorld)
        if ok and type(n) == "string" and n ~= "" then return n end
    end
    if world then
        local n = rawField(world, "name")
        if type(n) == "string" and n ~= "" then return n end
    end
    return nil
end

local function attempt(name)
    -- preferred: the game's own UI wrapper (hides picker, restores HUD)
    if menu and type(rawField(menu, "enter")) == "function" then
        local ok, err = pcall(menu.enter, name)
        return ok, err, "menu.enter"
    end
    -- wrapper reached through the buttons' connections (no getgc needed)
    if type(enterFn) == "function" then
        local ok, err = pcall(enterFn, name)
        return ok, err, "gui.enter"
    end
    -- fallback: raw join, then hide the picker ourselves
    if world and type(rawField(world, "enter")) == "function" then
        local ok, good, msg = pcall(world.enter, name)
        hidePicker()
        if not ok then return false, good, "world.enter" end
        return good ~= false, msg, "world.enter"
    end
    return false, "no enter function found", nil
end

local lastEvent = nil
local lastEventAt = 0

local function setEvent(text)
    lastEvent = text
    lastEventAt = os.clock()
    setStatus(text)
end

-- applyWorld() can take a moment; poll instead of one fixed sleep so a
-- slow join is not reported as a failure.
local function waitPickerGone(timeout)
    local t0 = os.clock()
    while (os.clock() - t0) < timeout do
        if not pickerVisible() then return true end
        task.wait(0.25)
    end
    return not pickerVisible()
end

-- ------------------------------------------------------------ startup report
task.spawn(function()
    ensureResolved(true)
    local _, picker = pickerParts()
    local joinRoute = menu and "menu.enter"
        or (enterFn and "gui.enter")
        or (world and "world.enter")
        or "none yet"
    say(string.format("menu=%s  args=%s  world=%s  picker=%s  join=%s",
        menu and "FOUND" or "not found",
        args and "FOUND" or "not found",
        world and "FOUND" or "not found",
        picker and "FOUND" or "not found",
        joinRoute))
    if joinRoute == "none yet" then
        say("waiting for the game UI / world table...")
    end
    local ok, vis = pcall(pickerVisible)
    if ok then say("picker visible right now: " .. tostring(vis)) end
end)

-- ------------------------------------------------------------ main loop
task.spawn(function()
    while gui.Parent do
        local now = os.clock()

        ensureResolved()

        local name = currentName()
        if name and genv then
            pcall(function() genv.__AJ_NAME = name end)
        end
        if not name and genv then
            local ok, cached = pcall(function() return genv.__AJ_NAME end)
            if ok and type(cached) == "string" and cached ~= "" then
                name = cached
            end
        end

        pcall(function()
            worldLine.Text = "world: " .. (name or "--")
        end)

        local vis = pickerVisible()

        if on and not busy and (now - lastTry) >= interval() then
            if vis and name and name ~= "" then
                lastTry = now
                busy = true
                local target = name

                task.spawn(function()
                    local ok, err, route = attempt(target)
                    local gone = waitPickerGone(3.0)
                    busy = false

                    if ok and gone then
                        joined = joined + 1
                        fails = 0
                        setEvent("joined " .. target .. "  (#" .. joined .. ")")
                        say("joined " .. target .. " via " .. tostring(route))
                    elseif ok and not gone then
                        fails = fails + 1
                        setEvent("still in menu - retrying")
                        say("enter returned but the picker is still open")
                        if fails == 6 then say("6 failed attempts - slowing to every 30s") end
                    else
                        fails = fails + 1
                        setEvent("failed: " .. tostring(err))
                        say("enter failed (" .. tostring(route) .. "): " .. tostring(err))
                        if fails == 6 then say("6 failed attempts - slowing to every 30s") end
                    end
                end)
            end
        end

        -- light status line (newer events stay visible for a few seconds)
        if on and not busy then
            local fresh = lastEvent and (now - lastEventAt) < 6
            if not fresh then
                if vis then
                    if name then
                        setStatus("menu open - joining every " .. interval() .. "s")
                    else
                        setStatus("menu open - no world name yet")
                    end
                elseif menu or world then
                    setStatus("watching (in world)")
                else
                    setStatus("waiting for the game UI")
                end
            end
        elseif not on then
            if lastEvent and (now - lastEventAt) < 6 then
                -- keep the last event visible after toggling off
            else
                setStatus("idle")
            end
        end

        task.wait(1)
    end
    say("panel closed -- loop stopped")
end)

say("v1.0 loaded.  toggle the button to auto re-enter the current world")
